{
  "name": "tempo",
  "productName": "Tempo",
  "version": "1.2.0",
  "description": "A calm, focused day planner for Windows",
  "main": "main.js",
  "author": "Adian",
  "license": "MIT",
  "homepage": "https://github.com/welovevyxzl/Tempo",
  "repository": { "type": "git", "url": "https://github.com/welovevyxzl/Tempo.git" },
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node tools/make-icon.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.adian.tempo",
    "productName": "Tempo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tempo",
      "artifactName": "Tempo-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Tempo-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
